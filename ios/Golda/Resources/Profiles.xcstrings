    "Each profile keeps its own accounts, goals, payments and budget." : {
      "comment" : "New profile alert: what a profile is.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each profile keeps its own accounts, goals, payments and budget."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого профиля свои счета, цели, платежи и бюджет."
          }
        }
      }
    },
    "Each profile keeps its own accounts, goals, payments and budget. The menu at the top of every tab switches between them." : {
      "comment" : "Profiles list: what profiles are and where to switch them.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each profile keeps its own accounts, goals, payments and budget. The menu at the top of every tab switches between them."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого профиля свои счета, цели, платежи и бюджет. Переключаются они меню вверху каждой вкладки."
          }
        }
      }
    },
    "Everyone here sees and changes this profile, and gets the same “Safe to spend today”. It’s kept in your iCloud." : {
      "comment" : "Profile screen, sharing: the owner's profile that others joined.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone here sees and changes this profile, and gets the same “Safe to spend today”. It’s kept in your iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все участники видят и меняют этот профиль, и «Можно сегодня» у всех одно. Профиль хранится в вашем iCloud."
          }
        }
      }
    },
    "Everyone you invited loses this profile on their phones. It stays on yours." : {
