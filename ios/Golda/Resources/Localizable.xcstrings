    "“%@” costs %@, more than “%@” earns (%@). Spare money does more paying it off." : {
      "comment" : "Accounts hero: the dearest debt costs more than the best savings account earns. Debt name, its rate, savings name, its rate.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” costs %@, more than “%@” earns (%@). Spare money does more paying it off."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» стоит %2$@ — дороже, чем приносит «%3$@» (%4$@). Лишние деньги выгоднее пустить на него."
          }
        }
      }
    },
    "“%@” earns %@, more than your debts cost. Paying early does not pay." : {
